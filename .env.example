# Copy to .env for local runs; app/config.py loads it automatically.
# Defaults match app/config.py. Docker Compose sets SV_HOST=0.0.0.0 internally.

# gRPC server (bind 0.0.0.0 when running in a container).
SV_HOST=localhost
SV_PORT=50051
SV_MAX_RECV_MB=16
SV_MAX_SEND_MB=16

# ABSA model. The first run may download model files from Hugging Face.
# For reproducible releases, replace main revisions with model commit IDs.
ABSA_MODEL_ID=visolex/xlm-roberta-absa-hotel
ABSA_FALLBACK_MODEL_ID=visolex/xlm-r-absa-hotel
ABSA_MODEL_REVISION=main
ABSA_FALLBACK_MODEL_REVISION=main
ABSA_TOKENIZER_FALLBACK_REVISION=main
ABSA_MAX_LENGTH=256
ABSA_BATCH_SIZE=16
ABSA_CONFIDENCE_THRESHOLD=0.5
ABSA_DEVICE=cpu
ABSA_TORCH_NUM_THREADS=2

# Booking model artifacts (paths relative to the working directory).
BOOKING_MODEL_PATH=models/booking_cancel_catboost.cbm
BOOKING_CALIBRATOR_PATH=models/booking_cancel_calibrator.pkl
BOOKING_META_PATH=models/booking_cancel_meta.json
BOOKING_CANCEL_THRESHOLD=0.5
